{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "${COPILOT_HOME:-$HOME/.copilot}/hooks/bin/session_context.py cache",
        "timeoutSec": 10
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "bash": "${COPILOT_HOME:-$HOME/.copilot}/hooks/bin/session_context.py inject",
        "timeoutSec": 5
      }
    ]
  }
}
